# ===================================================
# AhBiYout screensavergenerator - .gitignore
# ===================================================

# 1. Node & Package Dependencies
node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# 2. Build & Production Outputs
dist/
dist-ssr/
build/
out/
release/
Output/
*.local

# 3. Tauri & Rust Artifacts
src-tauri/target/
src-tauri/target/**
target/
**/*.rs.bk
Cargo.lock.bak

# 4. Binary Release & Installer Files
*.exe
*.msi
*.dmg
*.deb
*.rpm
*.AppImage
*.apk
*.aab
*.ipa

# 5. Cache & Temporary Directories
.cache/
.vite/
.turbo/
.parcel-cache/
.eslintcache
*.tmp
*.temp
*.swp
*.swo
*.bak

# 6. Environment & Secret Configs
.env
.env.*
!.env.example

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 8. IDE & Editor Files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosv
*.sln.docstates

# 9. Test & Coverage
coverage/
.nyc_output/
