{
  "name": "screensavergenerator",
  "private": true,
  "version": "1.1.0",
  "description": "Windows 10/11 화면 보호기 설정 관리자 및 자동 배치 파일(.bat) 생성기",
  "author": {
    "name": "AhBiYout",
    "email": "redmunlight@gmail.com",
    "url": "https://ahbiyoutvibe.blogspot.com/"
  },
  "company": "cisnet",
  "homepage": "https://ahbiyoutvibe.blogspot.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/AhBiYout/screensavergenerator"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npx vite build --emptyOutDir",
    "build:exe": "call build.bat",
    "build:tauri": "npm run clean && call npm run build && tauri build",
    "tauri": "tauri",
    "preview": "vite preview",
    "clean": "npx rimraf dist src-tauri/target",
    "postinstall": "node scripts/generate-bat.js",
    "version:sync": "node scripts/sync-version.js",
    "github:push": "call scripts/github-push.bat",
    "github:sync": "bash scripts/github-sync.sh",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tauri-apps/plugin-fs": "~2.5.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
